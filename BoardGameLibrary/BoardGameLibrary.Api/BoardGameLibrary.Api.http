@BoardGameLibrary.Api_HostAddress = http://localhost:5006

### The Development root opens Swagger UI automatically.
GET {{BoardGameLibrary.Api_HostAddress}}/
Accept: text/html

### Get the whole library.
GET {{BoardGameLibrary.Api_HostAddress}}/api/games
Accept: application/json

### Find games that support 4 players.
GET {{BoardGameLibrary.Api_HostAddress}}/api/games?players=4
Accept: application/json

### Find the highest-rated local options for 4 players.
GET {{BoardGameLibrary.Api_HostAddress}}/api/games?players=4&sort=rating
Accept: application/json

### Find highly rated options for 4 players that fit within 90 minutes.
GET {{BoardGameLibrary.Api_HostAddress}}/api/games?players=4&maxMinutes=90&sort=rating
Accept: application/json

### Sort the library by play time.
GET {{BoardGameLibrary.Api_HostAddress}}/api/games?sort=playtime
Accept: application/json

### Get one game and its rating for 3 players.
GET {{BoardGameLibrary.Api_HostAddress}}/api/games/1?players=3
Accept: application/json

### Add a game with player-count-specific local ratings.
POST {{BoardGameLibrary.Api_HostAddress}}/api/games
Content-Type: application/json

{
  "title": "Example Game",
  "minPlayers": 2,
  "maxPlayers": 4,
  "minPlayTimeMinutes": 45,
  "maxPlayTimeMinutes": 90,
  "playerRatings": [
    { "playerCount": 2, "rating": 7.5 },
    { "playerCount": 3, "rating": 8.5 },
    { "playerCount": 4, "rating": 8.0 }
  ]
}
