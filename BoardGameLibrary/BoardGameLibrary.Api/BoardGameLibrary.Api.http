@BoardGameLibrary.Api_HostAddress = http://localhost:5006

### Get all board games
GET {{BoardGameLibrary.Api_HostAddress}}/api/games
Accept: application/json

### Get games suitable for 1 player
GET {{BoardGameLibrary.Api_HostAddress}}/api/games?players=1
Accept: application/json

### Get one board game
GET {{BoardGameLibrary.Api_HostAddress}}/api/games/1
Accept: application/json

### Add a board game
POST {{BoardGameLibrary.Api_HostAddress}}/api/games
Content-Type: application/json

{
  "title": "Dune: Imperium",
  "minPlayers": 1,
  "maxPlayers": 4
}
