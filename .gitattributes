# Normalize repository text files so Windows line-ending settings do not create noisy diffs.
* text=auto

# Keep source, project, documentation, and configuration files in a consistent LF form.
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.http text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
